      <trans-unit id="CodeSystem-enlist-change-type" resname="CodeSystem.concept.definition">
             <notes>
               <note id="n1">CodeSystem.concept.definition</note>
             </notes>
        <source>Modifizierte Linie (Y+1): nicht-progressionsbedingte Änderung — Intoleranz, Hinzunahme/Wechsel eines Wirkstoffs, finanzielle oder logistische Gründe.</source>
        <target></target>
      </trans-unit>
