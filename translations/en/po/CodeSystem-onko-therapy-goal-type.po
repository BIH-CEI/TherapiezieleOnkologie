# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Heilung"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Kuratives Ziel — vollständige Remission angestrebt."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Lebensverlängerung"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Verlängerung des Gesamtüberlebens, wenn Heilung unwahrscheinlich ist."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Symptomkontrolle / Palliation"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Zielzustand einer definierten Symptomlast; symptombezogen erfasst — über Symptomskala oder erfragte Symptomlast."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Lebensqualität"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Erhalt oder Verbesserung der globalen, patientenberichteten Lebensqualität; erfasst per standardisiertem PROM oder strukturiertem Interview (z. B. SEIQoL-DW, Zielklärungsgespräch)."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Funktionserhalt"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Erhalt einer konkret benannten Körperfunktion oder -struktur (z. B. Brusterhalt, Kontinenz, Fertilität); patientenpriorisiertes Ziel, das die Maßnahmenwahl in beide Richtungen steuert und eigenständig nachgehalten wird."
msgstr ""

