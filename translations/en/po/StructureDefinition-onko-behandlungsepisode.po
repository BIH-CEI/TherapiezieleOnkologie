# Text that can be used to describe the constraint in messages identifying that the constraint has been violated.
#: StructureDefinition.element.EpisodeOfCare/constraint
msgid "Eine EnLiST-LoT-Designation (enlist-lot) darf nur vorliegen, wenn der Zählstatus (enlist-countable) 'counted' ist."
msgstr "Eine EnLiST-LoT-Designation (enlist-lot) darf nur vorliegen, wenn der Zählstatus (enlist-countable) 'counted' ist."

# Text that can be used to describe the constraint in messages identifying that the constraint has been violated.
#: StructureDefinition.element.EpisodeOfCare/constraint
msgid "Zählstatus 'counted' erfordert eine EnLiST-Designation (enlist-lot, führende Episode) oder einen Segment-Marker (enlist-line-segment, ausführende Episode)."
msgstr "Zählstatus 'counted' erfordert eine EnLiST-Designation (enlist-lot, führende Episode) oder einen Segment-Marker (enlist-line-segment, ausführende Episode)."

# Text that can be used to describe the constraint in messages identifying that the constraint has been violated.
#: StructureDefinition.element.EpisodeOfCare/constraint
msgid "enlist-lot (führende Episode) und enlist-line-segment (ausführendes Segment) dürfen nicht an derselben Episode vorliegen."
msgstr "enlist-lot (führende Episode) und enlist-line-segment (ausführendes Segment) dürfen nicht an derselben Episode vorliegen."

# Text that can be used to describe the constraint in messages identifying that the constraint has been violated.
#: StructureDefinition.element.EpisodeOfCare/constraint
msgid "Therapeutische Episodenarten (systemische Therapielinie, lokoregionale Behandlungslinie) erfordern mindestens einen Diagnosebezug."
msgstr "Therapeutische Episodenarten (systemische Therapielinie, lokoregionale Behandlungslinie) erfordern mindestens einen Diagnosebezug."

# Text that can be used to describe the constraint in messages identifying that the constraint has been violated.
#: StructureDefinition.element.EpisodeOfCare/constraint
msgid "EnLiST-Designation (enlist-lot), Segment-Marker (enlist-line-segment) und Zählstatus 'counted' sind nur bei Episodenart 'systemische Therapielinie' zulässig."
msgstr "EnLiST-Designation (enlist-lot), Segment-Marker (enlist-line-segment) und Zählstatus 'counted' sind nur bei Episodenart 'systemische Therapielinie' zulässig."

