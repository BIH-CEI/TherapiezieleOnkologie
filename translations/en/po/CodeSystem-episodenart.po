# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Systemische Therapielinie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Abschnitt aktiver systemischer Therapie (Line of Therapy, LoT) — EnLiST-konform und in die LoT-Zählung aufgenommen."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Lokoregionale Behandlungslinie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Nicht-systemische Behandlungslinie: Chirurgie, Strahlentherapie, Ablation — von EnLiST nicht abgedeckt, nicht in der LoT-Zählung."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Diagnostiklinie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Abgegrenzter diagnostischer Abschnitt (Grading, Staging, molekulare Charakterisierung) als Grundlage einer Tumorboard-Empfehlung; nicht-therapeutisch."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Active Surveillance"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Aktive Überwachung mit kurativer Rückfallebene — engmaschiges Monitoring statt sofortiger Therapie."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Watchful Waiting"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Abwartendes Beobachten — symptomorientiertes Vorgehen ohne kurative Rückfallebene."
msgstr ""

